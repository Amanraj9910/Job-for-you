# Copy to .env (never commit .env). Everything here is optional.

# Shown in the HTTP User-Agent so site owners can reach you if your tool misbehaves (an email or URL).
JOBHUNT_CONTACT=

# Optional extra sources
SERPAPI_KEY=            # Google Jobs through SerpApi (paid, has a small free tier). Off when empty.
HIMALAYAS_API_KEY=      # Himalayas works without a key; a key raises limits.

# Optional paths (defaults: ./profile, ./data/jobhunt.db, ./output)
# JOBHUNT_PROFILE=
# JOBHUNT_DB=
# JOBHUNT_OUTPUT=
